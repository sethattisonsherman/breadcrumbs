# Never commit .env. Replace this placeholder password in both values.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://breadcrumbs:replace-with-a-long-random-password@127.0.0.1:5432/breadcrumbs
PORT=3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supabase: replace DATABASE_URL above with the Session pooler URI from Connect.
# Use the database password, not the anon/publishable/service-role API key.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres
DATABASE_POOL_MAX=5
DATABASE_SCHEMA=public
# Optional path to the server CA certificate downloaded from your DB provider.
# DATABASE_CA_CERT_PATH=./secrets/database-ca.crt

SUPABASE_GEMINI_FUNCTION_URL=https://kwykvpxunzbjwfczccey.supabase.co/functions/v1/gemini-plan
SUPABASE_GEMINI_FUNCTION_TOKEN=

# Public Cloudflare Turnstile site key used by the browser (never put its secret here).
VITE_TURNSTILE_SITE_KEY=
